@using EntityLayer.Concrete;
@model List<Feature>

<div class="best-rooms py-5">
    <div class="container py-md-5">
        <div class="ban-content-inf row">

            @* İlk kayıt: büyük blok *@
            <div class="maghny-gd-1 col-lg-6">
                <div class="maghny-grid">
                    <figure class="effect-lily border-radius m-0">
                        <img class="img-fluid" src="@Model[0].Image" alt="" />
                        <figcaption>
                            <div>
                                <h4>@Model[0].Post</h4>
                                <p>@Model[0].Description</p>
                            </div>
                        </figcaption>
                    </figure>
                </div>
            </div>

            @* Kalan 4 kayıt: 2x2 grid *@
            <div class="maghny-gd-1 col-lg-6 mt-lg-0 mt-4">
                <div class="row">
                    @for (int i = 1; i < Model.Count; i++)
                    {
                        <div class="maghny-gd-1 col-6 @(i > 2 ? "mt-4" : "")">
                            <div class="maghny-grid">
                                <figure class="effect-lily border-radius">
                                    <img class="img-fluid" src="@Model[i].Image" alt="" />
                                    <figcaption>
                                        <div>
                                            <h4>@Model[i].Post</h4>
                                            <p>@Model[i].Description</p>
                                        </div>
                                    </figcaption>
                                </figure>
                            </div>
                        </div>
                    }
                </div>
            </div>

        </div>
    </div>
</div>